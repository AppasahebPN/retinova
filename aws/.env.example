# ============================================================
# RETINOVA AWS Cloud Infrastructure Environment Variables
# Copy to .env in production deployment environments
# ============================================================

# AWS Region & Account
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012

# DynamoDB
AWS_DYNAMODB_TABLE=RetinovaDetectionEvents

# S3 Evidence Storage
AWS_S3_BUCKET=retinova-evidence-vault-123456789012

# SNS Critical Escalations
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:RetinovaCriticalAlerts

# Cognito Authentication
AWS_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Gateway Production Endpoint
AWS_API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com

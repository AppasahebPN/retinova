# ============================================================
# RETINOVA — .gitignore
# Explainable AI for Diabetic Retinopathy Screening
# ============================================================

# --- Dependencies ---
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build & Bundle Artifacts ---
dist/
*/dist/
build/
*/build/
web-build/
*/web-build/
.expo/
*/.expo/
*.apk
*.aab
*.ipa
*.tsbuildinfo
*/tsconfig.tsbuildinfo

# --- Python & Caches ---
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
*/.pytest_cache/
.cache/
*/.cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/
env/
ENV/

# --- Environment & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.secret
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision
credentials.json
serviceAccountKey.json

# --- Runtime Uploads, Patient Data & Generated Artifacts ---
uploads/
*/uploads/
!backend/uploads/
backend/uploads/*
!backend/uploads/.gitkeep
generated_reports/
*/generated_reports/
report_*.html
*/report_*.html
temp_report_*.html
*/temp_report_*.html
test_card_*.png
*/test_card_*.png

# --- Database & Local Dumps ---
*.sqlite
*.sqlite3
*.db
local_db/
*.sql.gz
*.dump

# --- Logs ---
logs/
*/logs/
*.log
*.log.*

# --- MATLAB Temporary & Cache Files ---
*.asv
*.m~
*.slxc
slprj/
*/slprj/
*.autosave
*Features*Cache.mat
*train_cache.mat
*val_cache.mat

# --- OS & Editor Files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# --- One-off Scratch / Temp Testing Scripts ---
scratch/
*/scratch/
test_*.png
preview_*.png

# --- Design & Prototype Exports ---
figma-source/

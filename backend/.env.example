# ============================================================
# RETINOVA Cloud Backend — Environment Configuration Template
# Copy this file to .env for local deployment or configure in
# the Render Web Service Environment Settings dashboard.
# NEVER commit production secrets, keys, or credentials to git.
# ============================================================

# Runtime Environment & Port
NODE_ENV=production
PORT=10000

# Authentication & Cryptographic Security
# REQUIRED: Must be at least 32 characters in production.
# Generate on Linux/macOS/Git-Bash: openssl rand -hex 32
# Generate with Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_32_byte_hex_string_here
JWT_EXPIRES_IN=7d

# Relational Database Connection (PostgreSQL)
# Use Render Managed PostgreSQL connection string or external hosted PostgreSQL
# Example: postgres://retinova_user:secret@dpg-xxxx.oregon-postgres.render.com/retinova_db
DATABASE_URL=postgresql://user:password@host:5432/retinova

# Persistent Retinal Evidence Storage (AWS S3)
# Render Free disk is ephemeral. S3 is used for permanent retention of
# fundus images, Grad-CAM overlays, vessel masks, and retinal composites.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=retinova-evidence-vault
AWS_DYNAMODB_TABLE=RetinovaDetectionEvents
AWS_SNS_TOPIC_ARN=

# CORS Allowed Origins
# Comma-separated list of allowed origins.
# Mobile APKs (which send no Origin header) are automatically permitted.
# Example: https://retinova-backend.onrender.com,http://localhost:3000
CORS_ORIGINS=*

# Local Ephemeral Storage Fallback (only used if AWS S3 is not configured)
STORAGE_PATH=./uploads

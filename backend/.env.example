# RETINOVA Backend Platform - Environment Configuration Template
# Copy this file to .env and configure for your deployment environment

# Node.js Application Environment ('development' or 'production')
NODE_ENV=production
PORT=5000

# Authentication & Cryptographic Security
# REQUIRED IN PRODUCTION: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<GENERATE_A_RANDOM_SECRET>
JWT_EXPIRES_IN=7d

# Relational Database Connection (AI Host Local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netra_ai

# AI Inference Pipeline Engine ('matlab' for Swin V2 + Module 3; never 'mock' in production)
AI_SERVICE_TYPE=matlab
MATLAB_SERVICE_URL=http://localhost:8000

# Simulation Service Engine ('matlab' for SimEvents; never 'mock' in production)
SIMULATION_SERVICE_TYPE=matlab
MATLAB_SIMULINK_URL=http://localhost:8000

# File Upload Storage Directory
STORAGE_PATH=./uploads

# CORS Origin Whitelist (Explicit HTTPS domain in production; do not use wildcard '*')
# Example: https://retinova.org or https://app.retinova.health
CORS_ORIGIN=https://<PUBLIC_FRONTEND_DOMAIN>

# ============================================================
# RETINOVA Android Field Application — Environment Configuration
# Copy this file to .env and configure the base URL for the backend
# ============================================================

# PRODUCTION: Render Hosted Web Service URL (No trailing slash)
# Replace <your-render-service> with your live Render service subdomain
EXPO_PUBLIC_API_BASE_URL=https://<your-render-service>.onrender.com

# DEVELOPMENT / TESTING PRESETS:
# ------------------------------
# 1. Android Emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000
#
# 2. Local Wi-Fi / Physical Device Testing:
# EXPO_PUBLIC_API_BASE_URL=http://<YOUR_COMPUTER_LAN_IP>:5000
#
# 3. Local Web Browser Dev:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@react-navigation/stack": "^7.11.2",
    "expo": "~57.0.23",
    "expo-constants": "^57.0.18",
    "expo-image-picker": "^57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.28.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "start:retinova": "npm --prefix .. run start:retinova",
    "restart:retinova": "npm --prefix .. run restart:retinova",
    "status:retinova": "npm --prefix .. run status:retinova",
    "stop:retinova": "npm --prefix .. run stop:retinova"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "react-native-safe-area-context",
        "react-native-screens"
      ]
    }
  },
  "private": true
}

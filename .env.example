# ============================================================
# RETINOVA — Global Environment Configuration Example
# Copy this file to .env and configure for your local environment
# ============================================================

# --- Node / Express Backend API ---
PORT=5000
NODE_ENV=development

# --- Authentication & Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netra_ai

# --- MATLAB / Python AI Bridge ---
AI_SERVICE_TYPE=matlab
MATLAB_SERVICE_URL=http://127.0.0.1:8000
MATLAB_PROJECT_PATH=./ai-pipeline

# --- Simulink / SimEvents Resource Planning ---
SIMULATION_SERVICE_TYPE=matlab
MATLAB_SIMULINK_URL=http://127.0.0.1:8000

# --- Frontend Web Serving ---
RETINOVA_WEB_DIST=./mobile-app/dist
CORS_ORIGIN=*

# --- Browser Auto-launch ---
RETINOVA_OPEN_BROWSER=true

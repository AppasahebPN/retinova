# NetraAI ASHA Field App — Environment Configuration
# Copy this file to .env and set the correct server address

# API base URL for the NetraAI backend
# Replace with the actual IP address of your server on the local network
EXPO_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP:5000

# Example (same machine):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Example (LAN deployment):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000
